rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId}/{allPaths=**} {
      // Users can read any profile image
      allow read: if true;
      // Only the specific user can upload their avatar, size < 5MB, must be image
      allow write: if isAuthenticated() && 
                   request.auth.uid == userId && 
                   request.resource.size < 5 * 1024 * 1024 && 
                   request.resource.contentType.matches('image/.*');
    }

    match /events/{eventId}/{allPaths=**} {
      // Anyone can view event banners
      allow read: if true;
      // Any authenticated user can upload an event image, size < 10MB, must be image
      allow write: if isAuthenticated() && 
                   request.resource.size < 10 * 1024 * 1024 && 
                   request.resource.contentType.matches('image/.*');
    }
  }
}
